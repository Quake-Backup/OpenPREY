#define MyAppName "openPR06"
#define MyAppVersion "@@APP_VERSION@@"
#define MyAppPublisher "DarkMatter Productions"
#define MyAppURL "https://www.darkmatter-quake.com"
#define MyAppExeName "openPR06-client_@@APP_ARCH@@.exe"
#define MyAppServerExeName "openPR06-ded_@@APP_ARCH@@.exe"
#define MyAppDocsFile "docs\\index.html"
#define MyAppInstallRegKey "Software\\DarkMatter Productions\\openPR06"
#define MyAppProtocolName "openpr06"
#define MyAppProtocolRegKey "Software\\Classes\\openpr06"
#define MyAppClientAppPathsKey "Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\" + MyAppExeName
#define PackageSource "@@PACKAGE_SOURCE@@"

[Setup]
; openPR06's own installer identity. Packages up to 0.15.0 reused openQ4's AppId
; {8FD95F4F-3E38-4E18-8DB6-584E6D97C7E4}, so Windows treated the two as one
; program and each installer reused the other's folder (see [Code] for the
; migration). Never share this value with another product.
AppId={{2A1958BE-D077-4AAB-B0CE-DF261CACD8F4}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
AppMutex=openPR06
AppReadmeFile={app}\README.html
ChangesAssociations=yes
DefaultDirName={code:GetDefaultInstallDir}
DefaultGroupName=openPR06
DisableProgramGroupPage=yes
UsePreviousAppDir=yes
LicenseFile=@@LICENSE_FILE@@
InfoBeforeFile=@@LICENSING_FILE@@
OutputDir=@@OUTPUT_DIR@@
OutputBaseFilename=@@OUTPUT_BASENAME@@
SetupIconFile=@@SETUP_ICON_FILE@@
UninstallDisplayName={#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=lowest
@@ARCH_ALLOWED_DIRECTIVE@@
@@ARCH_INSTALL_MODE_DIRECTIVE@@
VersionInfoVersion=@@APP_VERSION@@
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription=openPR06 Windows Installer
VersionInfoProductName={#MyAppName}
VersionInfoCopyright=Copyright 2026 DarkMatter Productions

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Additional options:"; Flags: unchecked
Name: "protocol"; Description: "Register openpr06:// browser links"; GroupDescription: "Browser integration:"; Flags: unchecked

[InstallDelete]
; PDBs older packages installed (symbols are now a separate download), and any
; openQ4 pack this version does not use: the engine skips them, so remove them.
@@INSTALL_DELETE@@

[Files]
Source: "{#PackageSource}\*"; DestDir: "{app}"; Excludes: "@@FILES_EXCLUDES@@"; Flags: ignoreversion recursesubdirs createallsubdirs

[UninstallDelete]
@@UNINSTALL_DELETE@@

[Registry]
Root: HKA; Subkey: "{#MyAppInstallRegKey}"; ValueType: string; ValueName: "InstallDir"; ValueData: "{app}"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppInstallRegKey}"; ValueType: string; ValueName: "InstallArch"; ValueData: "@@APP_ARCH@@"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppInstallRegKey}"; ValueType: string; ValueName: "InstallVersion"; ValueData: "{#MyAppVersion}"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppInstallRegKey}"; ValueType: string; ValueName: "ClientExe"; ValueData: "{app}\{#MyAppExeName}"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppInstallRegKey}"; ValueType: string; ValueName: "UninstallExe"; ValueData: "{uninstallexe}"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppInstallRegKey}"; ValueType: dword; ValueName: "ProtocolEnabled"; ValueData: "0"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppInstallRegKey}"; ValueType: dword; ValueName: "ProtocolEnabled"; ValueData: "1"; Tasks: protocol; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppClientAppPathsKey}"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "{#MyAppClientAppPathsKey}"; ValueType: string; ValueName: "Path"; ValueData: "{app}"; Flags: uninsdeletekey
Root: HKA; Subkey: "{#MyAppProtocolRegKey}"; ValueType: string; ValueName: ""; ValueData: "URL:openPR06 Protocol"; Tasks: protocol; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppProtocolRegKey}"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""; Tasks: protocol; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppProtocolRegKey}"; ValueType: string; ValueName: "FriendlyTypeName"; ValueData: "openPR06 Link"; Tasks: protocol; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppProtocolRegKey}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"; Tasks: protocol; Flags: uninsdeletekey
Root: HKA; Subkey: "{#MyAppProtocolRegKey}\shell"; ValueType: string; ValueName: ""; ValueData: "open"; Tasks: protocol; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppProtocolRegKey}\shell\open"; ValueType: string; ValueName: ""; ValueData: "Open in openPR06"; Tasks: protocol; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppProtocolRegKey}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: protocol; Flags: uninsdeletekey

[Icons]
Name: "{group}\openPR06"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"
Name: "{group}\Dedicated Server"; Filename: "{app}\{#MyAppServerExeName}"; WorkingDir: "{app}"
Name: "{group}\Documentation Portal"; Filename: "{app}\{#MyAppDocsFile}"
Name: "{group}\Package Overview"; Filename: "{app}\README.html"
Name: "{group}\Uninstall openPR06"; Filename: "{uninstallexe}"
Name: "{autodesktop}\openPR06"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{app}\docs\index.html"; Description: "Open the release documentation"; Flags: postinstall shellexec skipifsilent
Filename: "{app}\{#MyAppExeName}"; Description: "Launch openPR06"; WorkingDir: "{app}"; Flags: postinstall nowait skipifsilent unchecked

[Code]
const
  openQ4InstallRegKey = '{#MyAppInstallRegKey}';
  openQ4ProtocolRegKey = '{#MyAppProtocolRegKey}';
  openQ4DefaultInstallDir = '{localappdata}\Programs\openPR06';
  // Uninstall entry written by packages that shared openQ4's AppId. openQ4 and
  // old openPR06 packages both own it: only the openPR06 one may be removed.
  LegacySharedUninstallKey = 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{8FD95F4F-3E38-4E18-8DB6-584E6D97C7E4}_is1';

// True when Dir holds an openQ4 installation. openPR06 must never be installed
// over one: the two ship different packs under the same baseoq4 names.
function IsOpenQ4Folder(Dir: String): Boolean;
var
  FindRec: TFindRec;
begin
  Result := False;
  if Dir = '' then
    Exit;
  if FindFirst(AddBackslash(Dir) + 'openQ4-client_*.exe', FindRec) then
  begin
    Result := True;
    FindClose(FindRec);
  end;
end;

function GetDefaultInstallDir(Param: String): String;
var
  InstallDir: String;
begin
  if RegQueryStringValue(HKEY_AUTO, openQ4InstallRegKey, 'InstallDir', InstallDir) and
     (InstallDir <> '') and not IsOpenQ4Folder(InstallDir) then
    Result := InstallDir
  else
    Result := ExpandConstant(openQ4DefaultInstallDir);
end;

// Removes the shared-AppId uninstall entry when it is an old openPR06 install
// in the folder being installed, together with its uninstaller, so this
// install replaces it and openQ4's installer stops treating that folder as an
// earlier openQ4. Entries owned by openQ4, or by an openPR06 copy elsewhere,
// are left alone.
procedure RemoveLegacySharedUninstallEntry;
var
  AppDir: String;
  DisplayName: String;
  InstallLocation: String;
  UninstallString: String;
  UninstallExe: String;
begin
  if not RegQueryStringValue(HKEY_AUTO, LegacySharedUninstallKey, 'DisplayName', DisplayName) then
    Exit;
  if Pos('{#MyAppName}', DisplayName) <> 1 then
    Exit;
  if not RegQueryStringValue(HKEY_AUTO, LegacySharedUninstallKey, 'InstallLocation', InstallLocation) then
    Exit;
  AppDir := RemoveBackslashUnlessRoot(ExpandConstant('{app}'));
  if CompareText(RemoveBackslashUnlessRoot(InstallLocation), AppDir) <> 0 then
    Exit;

  if RegQueryStringValue(HKEY_AUTO, LegacySharedUninstallKey, 'UninstallString', UninstallString) then
  begin
    UninstallExe := RemoveQuotes(UninstallString);
    if CompareText(ExtractFileDir(UninstallExe), AppDir) = 0 then
    begin
      DeleteFile(UninstallExe);
      DeleteFile(ChangeFileExt(UninstallExe, '.dat'));
      DeleteFile(ChangeFileExt(UninstallExe, '.msg'));
    end;
  end;
  RegDeleteKeyIncludingSubkeys(HKEY_AUTO, LegacySharedUninstallKey);
end;

function RejectOpenQ4Folder: Boolean;
begin
  Result := IsOpenQ4Folder(WizardDirValue);
  if Result then
    SuppressibleMsgBox('openQ4 is installed in this folder:' + #13#10 + WizardDirValue + #13#10#13#10 +
      'openPR06 needs a folder of its own. Choose a different folder.', mbError, MB_OK, IDOK);
end;

function FormatExistingInstallSummary: String;
var
  InstallDir: String;
  InstallVersion: String;
  InstallArch: String;
begin
  Result := '';
  if not RegQueryStringValue(HKEY_AUTO, openQ4InstallRegKey, 'InstallDir', InstallDir) then
    Exit;
  if InstallDir = '' then
    Exit;

  RegQueryStringValue(HKEY_AUTO, openQ4InstallRegKey, 'InstallVersion', InstallVersion);
  RegQueryStringValue(HKEY_AUTO, openQ4InstallRegKey, 'InstallArch', InstallArch);

  Result := 'Existing openPR06 installation detected';
  if InstallVersion <> '' then
    Result := Result + ': version ' + InstallVersion;
  if InstallArch <> '' then
    Result := Result + ' (' + Uppercase(InstallArch) + ')';
  Result := Result + '.' + #13#10 + InstallDir + #13#10;
  if IsOpenQ4Folder(InstallDir) then
    Result := Result + 'openQ4 now occupies that folder, so setup will install openPR06 in a folder of its own.'
  else
    Result := Result + 'Setup will reuse that install location unless you choose a different folder.';
end;

@@CONTENT_PACK_CODE@@

procedure InitializeWizard;
var
  ExistingInstallSummary: String;
begin
  ExistingInstallSummary := FormatExistingInstallSummary;
  if ExistingInstallSummary <> '' then
    WizardForm.WelcomeLabel2.Caption :=
      WizardForm.WelcomeLabel2.Caption + #13#10#13#10 + ExistingInstallSummary;
  InitializeContentPacks;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
begin
  Result := True;
  // Checked again on the Ready page, which silent installs and a skipped
  // folder page still pass, before any content pack is downloaded.
  if (CurPageID = wpSelectDir) or (CurPageID = wpReady) then
    if RejectOpenQ4Folder then
    begin
      Result := False;
      Exit;
    end;
  if CurPageID = wpReady then
    Result := FetchContentPacks;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssInstall then
    RemoveLegacySharedUninstallEntry;
  if (CurStep = ssInstall) and (not WizardIsTaskSelected('protocol')) then
    RegDeleteKeyIncludingSubkeys(HKEY_AUTO, openQ4ProtocolRegKey);
  if CurStep = ssPostInstall then
    InstallContentPacks;
end;
